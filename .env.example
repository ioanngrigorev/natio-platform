# ------------------------------------------------------------------
# NATIO environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------
NODE_ENV=development
# api | worker | all  (docker-compose runs api and worker separately)
NATIO_PROCESS_ROLE=all
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info
# Public origins (used for CORS, cookies, links in docs & webhooks docs)
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# Comma separated list of allowed browser origins for the dashboard/admin APIs
CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------
DATABASE_URL=postgres://natio:natio@localhost:5432/natio
DATABASE_POOL_MAX=10
# Set to "require" behind managed Postgres with TLS
DATABASE_SSL=disable

# --- Redis / queues --------------------------------------------------
# Leave empty to use the in-process queue driver (development/tests only).
REDIS_URL=redis://localhost:6379
QUEUE_DRIVER=redis

# --- Secrets (generate with: openssl rand -hex 32) --------------------
# Used to encrypt provider credentials and webhook secrets at rest (AES-256-GCM).
NATIO_ENCRYPTION_KEY=replace-with-64-hex-chars
# Used to HMAC session tokens and CSRF tokens.
NATIO_SESSION_SECRET=replace-with-64-hex-chars

# --- Sessions --------------------------------------------------------
SESSION_TTL_HOURS=12
ADMIN_SESSION_TTL_HOURS=8
# "true" in production (cookies marked Secure; requires HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Proxy / client IP -----------------------------------------------
# Which peers are allowed to set X-Forwarded-For. Anything else and the socket address is used.
# "loopback" (default) is right when nothing but a local reverse proxy sits in front of the API.
# Behind a load balancer set this to its address or CIDR (e.g. 10.0.0.0/8); "false" ignores XFF.
# NEVER "true": that lets any client forge its IP and bypass project IP allow-lists and rate limits.
TRUST_PROXY=loopback

# --- Rate limiting ---------------------------------------------------
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_DASHBOARD_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Payments defaults (business parameters; override per project) ----
DEFAULT_RETRY_MAX_ATTEMPTS=3
DEFAULT_RETRY_ON_SOFT_DECLINE=true
PROVIDER_TIMEOUT_MS=15000
IDEMPOTENCY_TTL_HOURS=24

# --- Webhooks --------------------------------------------------------
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=6
# Allow webhook URLs pointing to localhost/private networks (development only)
WEBHOOK_ALLOW_PRIVATE_URLS=true

# --- Sandbox seed ----------------------------------------------------
# Password for the seeded demo merchant user and admin (development only).
SEED_DEMO_PASSWORD=Natio-demo-2026
SEED_ADMIN_EMAIL=admin@natio.local
SEED_MERCHANT_EMAIL=owner@demo-merchant.local

# --- Web app ---------------------------------------------------------
# Server-side URL the Next.js app uses to reach the API (inside docker: http://api:4000)
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
