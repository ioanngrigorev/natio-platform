{
  "name": "@natio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NATIO orchestration API (modular monolith)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "NATIO_PROCESS_ROLE=worker tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:rotate-key": "tsx src/db/rotate-key.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "bullmq": "^5.41.0",
    "csv-parse": "^5.6.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.3.0",
    "ioredis": "^5.6.0",
    "pg": "^8.14.0",
    "pino": "^9.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
